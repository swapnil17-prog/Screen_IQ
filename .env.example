# Copy to .env and fill in. Never commit .env.

# ── Core ──────────────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
# Required in production: a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FRONTEND_URL=http://localhost:8080
ALLOW_PUBLIC_SIGNUP=true

# ── LLM (Anthropic Claude) ────────────────────────────────────────────────────
# anthropic = real Claude analysis; mock = offline heuristic demo (refused in production)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# ── Embeddings ────────────────────────────────────────────────────────────────
# bge    = local BAAI/bge-large-en-v1.5 (free, downloads ~1.3 GB once; needs INSTALL_ML=true)
# openai = text-embedding-3-small at 1024 dims (set OPENAI_API_KEY; you can build with INSTALL_ML=false)
# hash   = lexical demo embedder for tests/offline (refused in production)
EMBEDDING_PROVIDER=bge
# OPENAI_API_KEY=
INSTALL_ML=true

# ── Email (candidate interview invitations) ───────────────────────────────────
# Leave SMTP_HOST empty to log invitations to the backend console instead of sending them.
# Gmail: smtp.gmail.com / 587 / starttls, with an App Password (not your account password).
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address; defaults to SMTP_USERNAME
EMAIL_FROM=

# ── Database (docker compose) ─────────────────────────────────────────────────
POSTGRES_USER=screeniq
POSTGRES_PASSWORD=screeniq
POSTGRES_DB=screeniq
# Only when running the backend outside Docker:
# DATABASE_URL=postgresql+asyncpg://screeniq:screeniq@localhost:5432/screeniq

# ── Tuning (optional) ─────────────────────────────────────────────────────────
# MAX_UPLOAD_MB=10
# MAX_FILES_PER_UPLOAD=25
# MAX_CONCURRENT_PIPELINES=4
# INTERVIEW_LINK_TTL_DAYS=14
# REJECTION_EMAIL_DELAY_MINUTES=10    # undo window before a rejection email goes out
# INTERVIEW_REMINDER_HOURS=48         # remind unfinished candidates this long before expiry
# PASSWORD_RESET_TTL_MINUTES=60
# INVITE_TTL_DAYS=7
# RATE_LIMIT_APPLY_PER_MINUTE=5       # careers-page applications per IP
# LOG_JSON=true
